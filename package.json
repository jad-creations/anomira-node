{
  "name": "@anomira/node-sdk",
  "version": "0.2.7",
  "description": "Anomira Node.js SDK — drop-in API security monitoring for Express and Fastify",
  "author": "Anomira <sdk@anomira.io>",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jad-creations/anomira-node.git"
  },
  "bugs": {
    "url": "https://github.com/jad-creations/anomira-node/issues"
  },
  "homepage": "https://github.com/jad-creations/anomira-node#readme",
  "engines": {
    "node": ">=18"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "anomira": "./dist/cli.cjs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@secretlint/core": "^13.0.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "fastify": "^5.12.4",
    "prettier": "^3.4.2",
    "tsup": "^8.0.2",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "express": ">=4.0.0",
    "fastify": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    }
  },
  "keywords": [
    "security",
    "api",
    "monitoring",
    "anomira",
    "fraud-detection",
    "api-security",
    "express",
    "fastify",
    "sdk"
  ]
}
